# Required for Gemini recovery analysis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Vercel starts the app with demo accounts when this is not set to false.
# Its bundled SQLite database is temporary and resets when a function instance restarts.
SEED_DEMO_DATA=true

# Supabase (required for persistent data on Vercel)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
